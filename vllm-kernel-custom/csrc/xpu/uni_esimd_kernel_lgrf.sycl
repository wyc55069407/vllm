ESIMD_INLINE void esimd_mul_impl(uint8_t* a, uint8_t* b, uint8_t* c, int64_t len, nd_item<1>& ndi) {

  __ESIMD_NS::slm_init(16 * sizeof(fp16)); 

  int global_idx = ndi.get_group(0);
  int local_range = ndi.get_local_range(0);
  int local_idx = ndi.get_local_id(0);
  int inputOffset = (global_idx * local_range + local_idx) * 128 * sizeof(fp16);
  simd<fp16, 128> a_fp16;
  simd<fp16, 128> b_fp16;
  simd<fp16, 128> c_fp16;


      a_fp16.template bit_cast_view<uint8_t>().template select<256, 1>(0) =
              __ESIMD_ENS::lsc_block_load<
              uint8_t,
              256,
              __ESIMD_ENS::lsc_data_size::default_size,
              __ESIMD_ENS::cache_hint::cached,
              __ESIMD_ENS::cache_hint::cached>((uint8_t*)a + inputOffset);

      b_fp16.template bit_cast_view<uint8_t>().template select<256, 1>(0) =
              __ESIMD_ENS::lsc_block_load<
              uint8_t,
              256,
              __ESIMD_ENS::lsc_data_size::default_size,
              __ESIMD_ENS::cache_hint::cached,
              __ESIMD_ENS::cache_hint::cached>((uint8_t*)b + inputOffset);

      c_fp16 = a_fp16 * b_fp16;

    // if (local_idx < 16)
    {
      __ESIMD_ENS::lsc_block_store<
        fp16,
        128,
        __ESIMD_ENS::lsc_data_size::default_size,
        __ESIMD_ENS::cache_hint::write_back,
        __ESIMD_ENS::cache_hint::write_back>((fp16*)c + 128 * (global_idx * local_range + local_idx), c_fp16.select<128, 1>(0));
    }
    barrier();
    
}

void esimd_mul(uint8_t* a, uint8_t* b, uint8_t* c, int64_t len, sycl::queue& q){
    sycl::range<1> LocalRange(16); 
    sycl::range<1> GlobalRange(len / 128);

    sycl::nd_range<1> Range(GlobalRange, LocalRange);
    printf("--- global, local: %d, %d\n", 16, len / 128);
    sycl::event e;
    try {
      {
        e = q.submit([&](handler& cgh) {
        cgh.parallel_for(Range, [=](nd_item<1> ndi) SYCL_ESIMD_KERNEL{
              esimd_mul_impl(a, b, c, len, ndi);
            });
         });
      }
    } catch (sycl::exception const &e) {
      std::cout << "SYCL exception caught: " << e.what() << '\n';
      return;
    }
}

at::Tensor esimd_kernel_mul_lgrf(
    at::Tensor _p0,
    at::Tensor _p1,
    at::Tensor _p2,
    //at::Tensor _p3,
    //at::Tensor _p4,
    //at::Tensor _p5,
    //at::Tensor _p6,
    //at::Tensor _p7,
    //at::Tensor _p8,
    //at::Tensor _p9,

    int64_t i0,
    int64_t i1
    //int64_t i2,
    //int64_t i3,
    //int64_t i4,
    //int64_t i5,
    //int64_t i6,
    //int64_t i7,
    //int64_t i8,
    //int64_t i9,

    //float f0,
    //float f1,
    //float f2,
    //float f3,
    //float f4
    )
    {
    auto p0 = reinterpret_cast<uint8_t*>(_p0.data_ptr<at::Half>());
    auto p1 = reinterpret_cast<uint8_t*>(_p1.data_ptr<at::Half>());
    auto p2 = reinterpret_cast<uint8_t*>(_p2.data_ptr<at::Half>());
    //auto p3 = reinterpret_cast<uint8_t*>(_p3.data_ptr<uint8_t>());
    //auto p4 = reinterpret_cast<uint8_t*>(_p4.data_ptr<uint8_t>());
    //auto p5 = reinterpret_cast<uint8_t*>(_p5.data_ptr<uint8_t>());
    //auto p6 = reinterpret_cast<uint8_t*>(_p6.data_ptr<uint8_t>());
    //auto p7 = reinterpret_cast<uint8_t*>(_p7.data_ptr<uint8_t>());
    //auto p8 = reinterpret_cast<uint8_t*>(_p8.data_ptr<uint8_t>());
    //auto p9 = reinterpret_cast<uint8_t*>(_p9.data_ptr<uint8_t>());
    auto stream = at::xpu::getCurrentXPUStream();
    auto dpcpp_queue = stream.queue();

      switch(i0){
        case 1000:   // rms norm
          esimd_mul(p0, p1, p2, i1, dpcpp_queue);
          break;
        default:
          printf("---------- esimd uni-lgrf kernel op not supported, op is %lld ----------\n", i0);
          break;
      }
      return _p2;
    }

//template <uint32_t QK_DIM, uint32_t V_DIM>
bool runSdpFusion_mla(
      queue& q,
      uint8_t* q_extend,
      uint8_t* k_extend,
      uint8_t* v_extend,
      uint8_t* o_extend,
      uint8_t* k_buffer,
      uint8_t* v_buffer,
      uint8_t* kv_indices,
      unsigned num_heads,
      unsigned num_heads_kv,
      unsigned extend_seq_len,
      unsigned prefix_seq_len,
      unsigned qk_dim,
      unsigned v_dim,
      float attn_scale)
  {

  int qhead_div_kvhead = num_heads / num_heads_kv;

  int q_reduce_num = (extend_seq_len + (8 * SDP_THREAD - 1)) / (8 * SDP_THREAD);
  //printf("q_reduce_num %d num_heads %d,  qk_dim %d , v_dim %d !!\n", q_reduce_num, num_heads, qk_dim, v_dim);

  sycl::range<3> GlobalRange(num_heads / qhead_div_kvhead, qhead_div_kvhead, q_reduce_num * SDP_THREAD); // num_head x kv_len, batch size
  sycl::range<3> LocalRange(1, 1, SDP_THREAD); // kv_len, x
  sycl::nd_range<3> Range(GlobalRange, LocalRange);

  sycl::event e;
  try {
          e = q.submit([&](handler& cgh) {
          cgh.parallel_for<class mla_gemm_esimd>(Range, [=](nd_item<3> ndi) SYCL_ESIMD_KERNEL{
              SDP_xmx_gemm(q_extend, k_extend, v_extend, o_extend, k_buffer, v_buffer, kv_indices, num_heads, num_heads_kv,extend_seq_len, prefix_seq_len,attn_scale, ndi);
            });
          });
  } catch (sycl::exception const &e) {
    std::cout << "SYCL exception caught: " << e.what() << '\n';
    return false;
  }

  bool success = true;
  return success;
}

void esimd_kernel_sdp_mla(
      uint8_t* q_extend,
      uint8_t* k_extend,
      uint8_t* v_extend,
      uint8_t* k_buffer,
      uint8_t* v_buffer,
      //uint8_t* qo_indptr,
      //uint8_t* kv_indptr,
      uint8_t* kv_indices, //for 1 batch 
      uint8_t* o_extend,
      int64_t num_heads,
      int64_t num_heads_kv,
      int64_t extend_seq_len,
      int64_t prefix_seq_len,
      //int64_t batch_idx,
      int64_t qk_dim,
      int64_t v_dim,
      float attn_scale,

  sycl::queue& dpcpp_queue)
  {
    runSdpFusion_mla(dpcpp_queue, q_extend, k_extend, v_extend, o_extend, k_buffer, v_buffer, kv_indices, num_heads, num_heads_kv,extend_seq_len, prefix_seq_len,qk_dim,v_dim ,attn_scale );
  }

at::Tensor esimd_kernel_uni_lgrf(
    at::Tensor _p0,
    at::Tensor _p1,
    at::Tensor _p2,
    at::Tensor _p3,
    at::Tensor _p4,
    at::Tensor _p5,
    at::Tensor _p6,
    at::Tensor _p7,
    at::Tensor _p8,
    at::Tensor _p9,

    int64_t i0,
    int64_t i1,
    int64_t i2,
    int64_t i3,
    int64_t i4,
    int64_t i5,
    int64_t i6,
    int64_t i7,
    int64_t i8,
    int64_t i9,

    double f0,
    double f1,
    double f2,
    double f3,
    double f4
    )
    {
    auto p0 = reinterpret_cast<uint8_t*>(_p0.data_ptr());
    auto p1 = reinterpret_cast<uint8_t*>(_p1.data_ptr());
    auto p2 = reinterpret_cast<uint8_t*>(_p2.data_ptr());
    auto p3 = reinterpret_cast<uint8_t*>(_p3.data_ptr());
    auto p4 = reinterpret_cast<uint8_t*>(_p4.data_ptr());
    auto p5 = reinterpret_cast<uint8_t*>(_p5.data_ptr());
    auto p6 = reinterpret_cast<uint8_t*>(_p6.data_ptr());
    auto p7 = reinterpret_cast<uint8_t*>(_p7.data_ptr());
    auto p8 = reinterpret_cast<uint8_t*>(_p8.data_ptr());
    auto p9 = reinterpret_cast<uint8_t*>(_p9.data_ptr());
    auto stream = at::xpu::getCurrentXPUStream();
    auto dpcpp_queue = stream.queue();

      switch(i0){
        case 1006:   // sdp for MLA
          esimd_kernel_sdp_mla(p0, p1, p2, p3, p4, p5, p6, i1, i2, i3, i4, i5, i6, f0, dpcpp_queue);
        break;
        default:
          printf("---------- esimd kernel op not supported, op is %lld ----------\n", i0);
        break;
      }
      return _p9;
    }
/* Named wrapper for SDP MLA LGRF */
at::Tensor esimd_sdp_mla_lgrf(
    at::Tensor q_extend, at::Tensor k_extend, at::Tensor v_extend,
    at::Tensor k_buffer, at::Tensor v_buffer,
    at::Tensor kv_indices, at::Tensor o_extend,
    int64_t num_heads, int64_t num_heads_kv,
    int64_t extend_seq_len, int64_t prefix_seq_len,
    int64_t qk_dim, int64_t v_dim,
    double attn_scale) {
    auto p0 = reinterpret_cast<uint8_t*>(q_extend.data_ptr());
    auto p1 = reinterpret_cast<uint8_t*>(k_extend.data_ptr());
    auto p2 = reinterpret_cast<uint8_t*>(v_extend.data_ptr());
    auto p3 = reinterpret_cast<uint8_t*>(k_buffer.data_ptr());
    auto p4 = reinterpret_cast<uint8_t*>(v_buffer.data_ptr());
    auto p5 = reinterpret_cast<uint8_t*>(kv_indices.data_ptr());
    auto p6 = reinterpret_cast<uint8_t*>(o_extend.data_ptr());
    auto stream = at::xpu::getCurrentXPUStream();
    auto& dpcpp_queue = stream.queue();
    esimd_kernel_sdp_mla(p0, p1, p2, p3, p4, p5, p6,
        num_heads, num_heads_kv, extend_seq_len, prefix_seq_len,
        qk_dim, v_dim, attn_scale, dpcpp_queue);
    return o_extend;
}

/* ============================================================
 * Full Attention SDP — FP16, BF16, BF16io (non-causal)
 * Input: [B=1, L, H, 128] contiguous → squeeze(0) → [L, H, 128]
 * normAlpha: float[H * 128], all 1.0 for standard attention
 * ============================================================ */

static void sdp_fp16_kernel(
    sycl::queue& q,
    uint8_t* qState, uint8_t* kState, uint8_t* vState,
    uint8_t* normAlpha, uint8_t* out,
    uint32_t q_len, uint32_t kv_len,
    uint32_t headQ, uint32_t headKv)
{
    uint32_t q_blocks = (q_len + 255) / 256;
    sycl::range<2> GlobalRange(headQ * 16, q_blocks);
    sycl::range<2> LocalRange(16, 1);
    sycl::nd_range<2> Range(GlobalRange, LocalRange);

    q.submit([&](sycl::handler& cgh) {
        cgh.parallel_for(Range, [=](sycl::nd_item<2> ndi) SYCL_ESIMD_KERNEL {
            flashAttnBMha128Fp16OptPrecomputed(
                qState, kState, vState, normAlpha, out,
                q_len, kv_len, headQ, headKv, ndi);
        });
    });
}

static void sdp_bf16_kernel(
    sycl::queue& q,
    uint8_t* qState, uint8_t* kState, uint8_t* vState,
    uint8_t* normAlpha, uint8_t* out,
    uint32_t q_len, uint32_t kv_len,
    uint32_t headQ, uint32_t headKv)
{
    uint32_t q_blocks = (q_len + 255) / 256;
    sycl::range<2> GlobalRange(headQ * 16, q_blocks);
    sycl::range<2> LocalRange(16, 1);
    sycl::nd_range<2> Range(GlobalRange, LocalRange);

    q.submit([&](sycl::handler& cgh) {
        cgh.parallel_for(Range, [=](sycl::nd_item<2> ndi) SYCL_ESIMD_KERNEL {
            flashAttnBMha128Bf16Precomputed(
                qState, kState, vState, normAlpha, out,
                q_len, kv_len, headQ, headKv, ndi);
        });
    });
}

static void sdp_bf16io_kernel(
    sycl::queue& q,
    uint8_t* qState, uint8_t* kState, uint8_t* vState,
    uint8_t* normAlpha, uint8_t* out,
    uint32_t q_len, uint32_t kv_len,
    uint32_t headQ, uint32_t headKv)
{
    uint32_t q_blocks = (q_len + 255) / 256;
    sycl::range<2> GlobalRange(headQ * 16, q_blocks);
    sycl::range<2> LocalRange(16, 1);
    sycl::nd_range<2> Range(GlobalRange, LocalRange);

    q.submit([&](sycl::handler& cgh) {
        cgh.parallel_for(Range, [=](sycl::nd_item<2> ndi) SYCL_ESIMD_KERNEL {
            flashAttnBMha128Bf16IoPrecomputed(
                qState, kState, vState, normAlpha, out,
                q_len, kv_len, headQ, headKv, ndi);
        });
    });
}

/* Named torch wrappers for SDP full attention.
 * Input convention: [B=1, L, H, D] → squeeze dim-0 to [L, H, D].
 * normAlpha is created internally (all 1.0).
 * Returns output in same [B=1, L, H, D] layout.
 */
at::Tensor esimd_sdp_fp16(
    at::Tensor Q, at::Tensor K, at::Tensor V, at::Tensor norm_alpha, at::Tensor output,
    int64_t q_len, int64_t kv_len, int64_t head_q, int64_t head_kv)
{
    auto stream = at::xpu::getCurrentXPUStream();
    auto& dpcpp_queue = stream.queue();
    sdp_fp16_kernel(dpcpp_queue,
        (uint8_t*)Q.data_ptr(), (uint8_t*)K.data_ptr(), (uint8_t*)V.data_ptr(),
        (uint8_t*)norm_alpha.data_ptr(), (uint8_t*)output.data_ptr(),
        (uint32_t)q_len, (uint32_t)kv_len, (uint32_t)head_q, (uint32_t)head_kv);
    return output;
}

at::Tensor esimd_sdp_bf16(
    at::Tensor Q, at::Tensor K, at::Tensor V, at::Tensor norm_alpha, at::Tensor output,
    int64_t q_len, int64_t kv_len, int64_t head_q, int64_t head_kv)
{
    auto stream = at::xpu::getCurrentXPUStream();
    auto& dpcpp_queue = stream.queue();
    sdp_bf16_kernel(dpcpp_queue,
        (uint8_t*)Q.data_ptr(), (uint8_t*)K.data_ptr(), (uint8_t*)V.data_ptr(),
        (uint8_t*)norm_alpha.data_ptr(), (uint8_t*)output.data_ptr(),
        (uint32_t)q_len, (uint32_t)kv_len, (uint32_t)head_q, (uint32_t)head_kv);
    return output;
}

at::Tensor esimd_sdp_bf16io(
    at::Tensor Q, at::Tensor K, at::Tensor V, at::Tensor norm_alpha, at::Tensor output,
    int64_t q_len, int64_t kv_len, int64_t head_q, int64_t head_kv)
{
    auto stream = at::xpu::getCurrentXPUStream();
    auto& dpcpp_queue = stream.queue();
    sdp_bf16io_kernel(dpcpp_queue,
        (uint8_t*)Q.data_ptr(), (uint8_t*)K.data_ptr(), (uint8_t*)V.data_ptr(),
        (uint8_t*)norm_alpha.data_ptr(), (uint8_t*)output.data_ptr(),
        (uint32_t)q_len, (uint32_t)kv_len, (uint32_t)head_q, (uint32_t)head_kv);
    return output;
}

/* ============================================================
 * GDN (Gated Delta Network) state update kernel
 * One ESIMD thread per (sequence, value_head).
 * ============================================================ */
at::Tensor esimd_gdn_update(
    at::Tensor A_log,          // [HV] f32
    at::Tensor dt_bias,        // [HV] f32
    at::Tensor a,              // [T_total, HV] bf16
    at::Tensor b,              // [T_total, HV] bf16
    at::Tensor q,              // [T_total, H, K] bf16
    at::Tensor k,              // [T_total, H, K] bf16
    at::Tensor v,              // [T_total, HV, V] bf16
    at::Tensor state,          // [num_states, HV, V, K] f32
    at::Tensor output,         // [T_total, HV, V] bf16
    at::Tensor cu_seqlens,     // [N+1] int32
    at::Tensor state_indices,  // [N] int32
    int64_t N, int64_t H, int64_t HV,
    int64_t K, int64_t V,
    double scale,
    int64_t inplace_state)
{
    auto stream = at::xpu::getCurrentXPUStream();
    auto& dpcpp_queue = stream.queue();

    int64_t num_threads = N * HV;
    sycl::range<1> GlobalRange(num_threads);
    sycl::range<1> LocalRange(1);
    sycl::nd_range<1> Range(GlobalRange, LocalRange);

    auto* A_log_ptr     = A_log.data_ptr<float>();
    auto* dt_bias_ptr   = dt_bias.data_ptr<float>();
    auto* a_ptr         = reinterpret_cast<const unsigned short*>(a.data_ptr());
    auto* b_ptr         = reinterpret_cast<const unsigned short*>(b.data_ptr());
    auto* q_ptr         = reinterpret_cast<const unsigned short*>(q.data_ptr());
    auto* k_ptr         = reinterpret_cast<const unsigned short*>(k.data_ptr());
    auto* v_ptr         = reinterpret_cast<const unsigned short*>(v.data_ptr());
    auto* state_ptr     = state.data_ptr<float>();
    auto* output_ptr    = reinterpret_cast<unsigned short*>(output.data_ptr());
    auto* cu_seqlens_ptr = cu_seqlens.data_ptr<int>();
    auto* state_idx_ptr = state_indices.data_ptr<int>();

    int n_val = (int)N, h_val = (int)H, hv_val = (int)HV;
    int k_val = (int)K, v_val = (int)V;
    float scale_f = (float)scale;
    int inplace = (int)inplace_state;

    dpcpp_queue.submit([&](sycl::handler& cgh) {
        cgh.parallel_for(Range, [=](sycl::nd_item<1> ndi) SYCL_ESIMD_KERNEL {
            gdn_update_kernel(
                A_log_ptr, dt_bias_ptr,
                a_ptr, b_ptr, q_ptr, k_ptr, v_ptr,
                state_ptr, output_ptr,
                cu_seqlens_ptr, state_idx_ptr,
                n_val, h_val, hv_val, k_val, v_val,
                scale_f, inplace, ndi);
        });
    });

    return output;
}

/* ============================================================
 * Paged SDP (Scaled Dot-Product) Attention — decode + prefill
 *
 * Dispatches between:
 *   - Decode (num_tokens == batch): Two-phase architecture
 *       Phase 1: per-chunk partial softmax + output
 *       Phase 2: cross-chunk log-sum-exp reduction
 *   - Prefill (num_tokens > batch): Scalar fallback (TODO: 32-thread WG DPAS)
 *       Uses sdp_paged_kernel_scalar for correctness.
 *       The DPAS prefill kernel (sdp_paged_prefill_kernel) requires
 *       host-side WG dispatch tables; will be enabled in a follow-up.
 * ============================================================ */
at::Tensor esimd_sdp_paged(
    at::Tensor query,           // [num_tokens, num_heads, head_dim] bf16/fp16
    at::Tensor kv_cache,        // [2, num_blocks, block_size, num_kv_heads, head_dim] bf16/fp16
    at::Tensor output,          // [num_tokens, num_heads, head_dim] bf16/fp16
    at::Tensor block_table,     // [batch, max_blocks_per_seq] i32
    at::Tensor seq_lens,        // [batch] i32
    at::Tensor query_start_loc, // [batch+1] i32
    int64_t num_heads, int64_t num_kv_heads,
    int64_t head_dim, int64_t block_size,
    int64_t max_seq_len, double attn_scale,
    int64_t causal)
{
    auto stream = at::xpu::getCurrentXPUStream();
    auto& dpcpp_queue = stream.queue();

    int batch = (int)seq_lens.size(0);
    int num_tokens = (int)query.size(0);
    int max_blocks_per_seq = (int)block_table.size(1);

    auto* query_us       = reinterpret_cast<const unsigned short*>(query.data_ptr());
    auto* kv_cache_us    = reinterpret_cast<const unsigned short*>(kv_cache.data_ptr());
    auto* output_us      = reinterpret_cast<unsigned short*>(output.data_ptr());
    auto* block_table_i  = block_table.data_ptr<int>();
    auto* seq_lens_i     = seq_lens.data_ptr<int>();
    auto* qsl_i          = query_start_loc.data_ptr<int>();

    int nh = (int)num_heads, nkvh = (int)num_kv_heads, hd = (int)head_dim;
    int bs = (int)block_size, mbps = max_blocks_per_seq;
    float as_f = (float)attn_scale;
    int c_val = (int)causal;

    // Extract KV cache strides (in elements) from the tensor.
    int64_t kv_s0 = kv_cache.stride(0);  // split (K vs V)
    int64_t kv_s1 = kv_cache.stride(1);  // block
    int64_t kv_s2 = kv_cache.stride(2);  // position within block
    int64_t kv_s3 = kv_cache.stride(3);  // kv head

    // Detect dtype: bf16 or fp16
    bool is_bf16 = (query.scalar_type() == at::ScalarType::BFloat16);

    // Determine decode vs prefill
    bool is_decode = (num_tokens == batch);

    if (is_decode && hd == 128) {
        // ===== Optimized two-phase decode for HD=128 =====
        // Runtime kv_len-based dispatch for optimal SP_BLK/CHUNK per sequence length.
        // Sweep results (32Q/2KV fp16, batch=1, in-order):
        //   kv<=4K:  QHT=4 HGPG=4 SP=64  CHK=512  → 127 GB/s
        //   kv<=8K:  QHT=4 HGPG=4 SP=128 CHK=1024 → 154 GB/s
        //   kv>8K:   QHT=4 HGPG=4 SP=256 CHK=1024 → 156-159 GB/s
        int gqa_ratio = nh / nkvh;
        int max_sl = (int)max_seq_len;

        // Phase2: one thread per HEADS_PER_THREAD=4 heads (shared across all configs)
        constexpr int P2_HPT_128 = 4;

        // Generic dispatch lambda: compile-time NKVH, QHT, SP_BLK, CHUNK, HGPG, BF16
        auto dispatch_128 = [&]<int NKVH, int QHT, int SP_BLK, int CHUNK, int HGPG, bool BF16>() {
            constexpr int SP_PER_T = CHUNK / SP_BLK;
            int num_chunks = (max_sl + CHUNK - 1) / CHUNK;

            // Separate fp32 scratch buffers — per-request scratch for batch>1 correctness
            int64_t scratch_out_elems = (int64_t)batch * num_chunks * nh * 128;
            int64_t scratch_sc_elems = (int64_t)batch * num_chunks * nh;
            auto scratch_out_t = at::empty({scratch_out_elems}, query.options().dtype(at::kFloat));
            auto scratch_max_t = at::empty({scratch_sc_elems}, query.options().dtype(at::kFloat));
            auto scratch_lse_t = at::empty({scratch_sc_elems}, query.options().dtype(at::kFloat));
            auto* s_out = scratch_out_t.data_ptr<float>();
            auto* s_max = scratch_max_t.data_ptr<float>();
            auto* s_lse = scratch_lse_t.data_ptr<float>();

            int64_t global_dim2 = (int64_t)batch * nkvh * HGPG;
            sycl::range<3> global_p1(1, (int64_t)num_chunks * SP_PER_T, global_dim2);
            sycl::range<3> local_p1(1, SP_PER_T, HGPG);

            int64_t p2_threads = (int64_t)batch * nh / P2_HPT_128;
            sycl::nd_range<1> p2_range(sycl::range<1>(p2_threads), sycl::range<1>(1));

            dpcpp_queue.submit([&](sycl::handler& cgh) {
                cgh.parallel_for(sycl::nd_range<3>(global_p1, local_p1),
                    [=](sycl::nd_item<3> ndi) SYCL_ESIMD_KERNEL {
                    sdp_paged_decode_opt_phase1<128, NKVH, QHT, SP_BLK, CHUNK, HGPG, BF16>(
                        query_us, kv_cache_us, s_out, s_max, s_lse,
                        block_table_i, seq_lens_i,
                        nh, bs, mbps,
                        kv_s0, kv_s1,
                        as_f, num_chunks, batch, ndi);
                });
            });
            dpcpp_queue.submit([&](sycl::handler& cgh) {
                cgh.parallel_for(p2_range, [=](sycl::nd_item<1> ndi) SYCL_ESIMD_KERNEL {
                    sdp_paged_decode_opt_phase2<128, P2_HPT_128, BF16>(
                        s_out, s_max, s_lse, output_us, seq_lens_i,
                        nh, num_chunks, batch, ndi);
                });
            });
        };

        if (gqa_ratio >= 16) {
            // 16:1 GQA (e.g. 32Q/2KV): QHT=4, HGPG=4
            // Runtime kv_len-based SP_BLK/CHUNK selection
            // NKVH template: 2 for common case, 4 for fallback
            #define DISPATCH_16TO1(NKVH_VAL, BF16_VAL) \
                if (max_sl <= 4096) { \
                    dispatch_128.template operator()<NKVH_VAL, 4, 64, 512, 4, BF16_VAL>(); \
                } else if (max_sl <= 8192) { \
                    dispatch_128.template operator()<NKVH_VAL, 4, 128, 1024, 4, BF16_VAL>(); \
                } else { \
                    dispatch_128.template operator()<NKVH_VAL, 4, 256, 1024, 4, BF16_VAL>(); \
                }
            if (nkvh == 2) {
                if (is_bf16) { DISPATCH_16TO1(2, true) }
                else         { DISPATCH_16TO1(2, false) }
            } else {
                if (is_bf16) { DISPATCH_16TO1(4, true) }
                else         { DISPATCH_16TO1(4, false) }
            }
            #undef DISPATCH_16TO1
        } else if (gqa_ratio >= 8) {
            // 8:1 GQA (e.g. 32Q/4KV): QHT=8, HGPG=1, SP=64, CHK=256
            if (is_bf16) dispatch_128.template operator()<4, 8, 64, 256, 1, true>();
            else         dispatch_128.template operator()<4, 8, 64, 256, 1, false>();
        } else if (gqa_ratio >= 4) {
            // 4:1 GQA: QHT=4, HGPG=1, SP=64, CHK=256
            if (is_bf16) dispatch_128.template operator()<4, 4, 64, 256, 1, true>();
            else         dispatch_128.template operator()<4, 4, 64, 256, 1, false>();
        } else {
            // GQA < 4: fall back to scalar
            goto scalar_fallback;
        }
    } else if (is_decode && hd == 256) {
        // ===== Optimized two-phase decode for HD=256 =====
        int gqa_ratio = nh / nkvh;

        if (gqa_ratio >= 4) {
            constexpr int QHT = 4;
            constexpr int DEC256_SP_BLK = 64;
            constexpr int DEC256_CHUNK = 64;
            constexpr int DEC256_SP_PER_T = DEC256_CHUNK / DEC256_SP_BLK;  // 1

            int max_sl = (int)max_seq_len;
            int num_chunks = (max_sl + DEC256_CHUNK - 1) / DEC256_CHUNK;

            // Separate fp32 scratch buffers — per-request scratch for batch>1
            int64_t scratch_out_elems = (int64_t)batch * num_chunks * nh * 256;  // HD=256
            int64_t scratch_sc_elems = (int64_t)batch * num_chunks * nh;
            auto scratch_out_t = at::empty({scratch_out_elems}, query.options().dtype(at::kFloat));
            auto scratch_max_t = at::empty({scratch_sc_elems}, query.options().dtype(at::kFloat));
            auto scratch_lse_t = at::empty({scratch_sc_elems}, query.options().dtype(at::kFloat));
            auto* s_out = scratch_out_t.data_ptr<float>();
            auto* s_max = scratch_max_t.data_ptr<float>();
            auto* s_lse = scratch_lse_t.data_ptr<float>();

            int head_groups_per_g = gqa_ratio / QHT;
            int64_t global_dim2 = (int64_t)batch * nkvh * head_groups_per_g;
            sycl::range<3> global_p1(1, (int64_t)num_chunks * DEC256_SP_PER_T, global_dim2);
            sycl::range<3> local_p1(1, DEC256_SP_PER_T, 1);

            constexpr int P2_HPT_256 = 4;
            int64_t p2_threads = (int64_t)batch * nh / P2_HPT_256;
            sycl::nd_range<1> p2_range(sycl::range<1>(p2_threads), sycl::range<1>(1));

            // HD=256 always uses HGPG=1 (4:1 GQA, QHT=4 covers all Q heads per KV head)
            if (is_bf16) {
                dpcpp_queue.submit([&](sycl::handler& cgh) {
                    cgh.parallel_for(sycl::nd_range<3>(global_p1, local_p1),
                        [=](sycl::nd_item<3> ndi) SYCL_ESIMD_KERNEL {
                        sdp_paged_decode_opt_phase1<256, 4, QHT, DEC256_SP_BLK, DEC256_CHUNK, 1, true>(
                            query_us, kv_cache_us, s_out, s_max, s_lse,
                            block_table_i, seq_lens_i,
                            nh, bs, mbps,
                            kv_s0, kv_s1,
                            as_f, num_chunks, batch, ndi);
                    });
                });
                dpcpp_queue.submit([&](sycl::handler& cgh) {
                    cgh.parallel_for(p2_range, [=](sycl::nd_item<1> ndi) SYCL_ESIMD_KERNEL {
                        sdp_paged_decode_opt_phase2<256, P2_HPT_256, true>(
                            s_out, s_max, s_lse, output_us, seq_lens_i,
                            nh, num_chunks, batch, ndi);
                    });
                });
            } else {
                dpcpp_queue.submit([&](sycl::handler& cgh) {
                    cgh.parallel_for(sycl::nd_range<3>(global_p1, local_p1),
                        [=](sycl::nd_item<3> ndi) SYCL_ESIMD_KERNEL {
                        sdp_paged_decode_opt_phase1<256, 4, QHT, DEC256_SP_BLK, DEC256_CHUNK, 1, false>(
                            query_us, kv_cache_us, s_out, s_max, s_lse,
                            block_table_i, seq_lens_i,
                            nh, bs, mbps,
                            kv_s0, kv_s1,
                            as_f, num_chunks, batch, ndi);
                    });
                });
                dpcpp_queue.submit([&](sycl::handler& cgh) {
                    cgh.parallel_for(p2_range, [=](sycl::nd_item<1> ndi) SYCL_ESIMD_KERNEL {
                        sdp_paged_decode_opt_phase2<256, P2_HPT_256, false>(
                            s_out, s_max, s_lse, output_us, seq_lens_i,
                            nh, num_chunks, batch, ndi);
                    });
                });
            }
        } else {
            // GQA < 4: fall back to scalar
            goto scalar_fallback;
        }
    } else if (hd == 256) {
        // ===== Prefill HD=256: DPAS-based 32-thread WG kernel =====
        int max_q_tiles_per_req = (num_tokens + 127) / 128;

        int64_t total_wgs = (int64_t)batch * max_q_tiles_per_req * nh;
        sycl::nd_range<1> Range(sycl::range<1>(total_wgs * 32), sycl::range<1>(32));

        if (is_bf16) {
            if (c_val) {
                dpcpp_queue.submit([&](sycl::handler& cgh) {
                    cgh.parallel_for(Range, [=](sycl::nd_item<1> ndi) SYCL_ESIMD_KERNEL {
                        sdp_paged_prefill_dpas<true, true>(
                            query_us, kv_cache_us, output_us,
                            block_table_i, seq_lens_i, qsl_i,
                            nh, nkvh, hd, bs, mbps,
                            kv_s0, kv_s1, kv_s2, kv_s3,
                            as_f, num_tokens,
                            max_q_tiles_per_req, batch, ndi);
                    });
                });
            } else {
                dpcpp_queue.submit([&](sycl::handler& cgh) {
                    cgh.parallel_for(Range, [=](sycl::nd_item<1> ndi) SYCL_ESIMD_KERNEL {
                        sdp_paged_prefill_dpas<false, true>(
                            query_us, kv_cache_us, output_us,
                            block_table_i, seq_lens_i, qsl_i,
                            nh, nkvh, hd, bs, mbps,
                            kv_s0, kv_s1, kv_s2, kv_s3,
                            as_f, num_tokens,
                            max_q_tiles_per_req, batch, ndi);
                    });
                });
            }
        } else {
            if (c_val) {
                dpcpp_queue.submit([&](sycl::handler& cgh) {
                    cgh.parallel_for(Range, [=](sycl::nd_item<1> ndi) SYCL_ESIMD_KERNEL {
                        sdp_paged_prefill_dpas<true, false>(
                            query_us, kv_cache_us, output_us,
                            block_table_i, seq_lens_i, qsl_i,
                            nh, nkvh, hd, bs, mbps,
                            kv_s0, kv_s1, kv_s2, kv_s3,
                            as_f, num_tokens,
                            max_q_tiles_per_req, batch, ndi);
                    });
                });
            } else {
                dpcpp_queue.submit([&](sycl::handler& cgh) {
                    cgh.parallel_for(Range, [=](sycl::nd_item<1> ndi) SYCL_ESIMD_KERNEL {
                        sdp_paged_prefill_dpas<false, false>(
                            query_us, kv_cache_us, output_us,
                            block_table_i, seq_lens_i, qsl_i,
                            nh, nkvh, hd, bs, mbps,
                            kv_s0, kv_s1, kv_s2, kv_s3,
                            as_f, num_tokens,
                            max_q_tiles_per_req, batch, ndi);
                    });
                });
            }
        }
    } else if (!is_decode && hd == 128) {
        // ===== Prefill HD=128: 16-thread WG DPAS kernel =====
        int max_q_tiles_per_req = (num_tokens + 255) / 256;  // 256 Q rows/WG
        int64_t total_wgs = (int64_t)batch * max_q_tiles_per_req * nh;
        sycl::nd_range<1> Range(sycl::range<1>(total_wgs * 16), sycl::range<1>(16));

        if (is_bf16) {
            if (c_val) {
                dpcpp_queue.submit([&](sycl::handler& cgh) {
                    cgh.parallel_for(Range, [=](sycl::nd_item<1> ndi) SYCL_ESIMD_KERNEL {
                        sdp_paged_prefill_dpas_128<true, true>(
                            query_us, kv_cache_us, output_us,
                            block_table_i, seq_lens_i, qsl_i,
                            nh, nkvh, hd, bs, mbps,
                            kv_s0, kv_s1, kv_s2, kv_s3,
                            as_f, num_tokens,
                            max_q_tiles_per_req, batch, ndi);
                    });
                });
            } else {
                dpcpp_queue.submit([&](sycl::handler& cgh) {
                    cgh.parallel_for(Range, [=](sycl::nd_item<1> ndi) SYCL_ESIMD_KERNEL {
                        sdp_paged_prefill_dpas_128<false, true>(
                            query_us, kv_cache_us, output_us,
                            block_table_i, seq_lens_i, qsl_i,
                            nh, nkvh, hd, bs, mbps,
                            kv_s0, kv_s1, kv_s2, kv_s3,
                            as_f, num_tokens,
                            max_q_tiles_per_req, batch, ndi);
                    });
                });
            }
        } else {
            if (c_val) {
                dpcpp_queue.submit([&](sycl::handler& cgh) {
                    cgh.parallel_for(Range, [=](sycl::nd_item<1> ndi) SYCL_ESIMD_KERNEL {
                        sdp_paged_prefill_dpas_128<true, false>(
                            query_us, kv_cache_us, output_us,
                            block_table_i, seq_lens_i, qsl_i,
                            nh, nkvh, hd, bs, mbps,
                            kv_s0, kv_s1, kv_s2, kv_s3,
                            as_f, num_tokens,
                            max_q_tiles_per_req, batch, ndi);
                    });
                });
            } else {
                dpcpp_queue.submit([&](sycl::handler& cgh) {
                    cgh.parallel_for(Range, [=](sycl::nd_item<1> ndi) SYCL_ESIMD_KERNEL {
                        sdp_paged_prefill_dpas_128<false, false>(
                            query_us, kv_cache_us, output_us,
                            block_table_i, seq_lens_i, qsl_i,
                            nh, nkvh, hd, bs, mbps,
                            kv_s0, kv_s1, kv_s2, kv_s3,
                            as_f, num_tokens,
                            max_q_tiles_per_req, batch, ndi);
                    });
                });
            }
        }
    } else {
    scalar_fallback: {
        // ===== Decode or non-128/256 head dim: scalar fallback =====
        int max_query_len = 0;
        if (num_tokens == batch) {
            max_query_len = 1;
        } else {
            max_query_len = (num_tokens + batch - 1) / batch;
            if (max_query_len <= 1) max_query_len = 2;
        }
        int mql = max_query_len;

        int64_t num_threads = (int64_t)num_tokens * nh;
        sycl::nd_range<1> Range(sycl::range<1>(num_threads), sycl::range<1>(1));

        if (is_bf16) {
            dpcpp_queue.submit([&](sycl::handler& cgh) {
                cgh.parallel_for(Range, [=](sycl::nd_item<1> ndi) SYCL_ESIMD_KERNEL {
                    sdp_paged_kernel_scalar<true>(
                        query_us, kv_cache_us, output_us,
                        block_table_i, seq_lens_i, qsl_i,
                        nh, nkvh, hd, bs, mbps,
                        kv_s0, kv_s1, kv_s2, kv_s3,
                        as_f, c_val, mql, ndi);
                });
            });
        } else {
            dpcpp_queue.submit([&](sycl::handler& cgh) {
                cgh.parallel_for(Range, [=](sycl::nd_item<1> ndi) SYCL_ESIMD_KERNEL {
                    sdp_paged_kernel_scalar<false>(
                        query_us, kv_cache_us, output_us,
                        block_table_i, seq_lens_i, qsl_i,
                        nh, nkvh, hd, bs, mbps,
                        kv_s0, kv_s1, kv_s2, kv_s3,
                        as_f, c_val, mql, ndi);
                });
            });
        }
    } }

    return output;
}
