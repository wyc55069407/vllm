/* W4A16 GPTQ ESIMD GEMV — SYCL dispatch for non-MoE linear layers.
 *
 * Two ops:
 *   esimd_w4a16_gemv:          General GEMV for QKV/O projections
 *   esimd_w4a16_gate_up_silu:  Fused gate+up+SiLU for shared expert
 *
 * Supports bf16/fp16 I/O, group_size 32/64/128, M=1..8.
 * Standard GRF (no doubleGRF) — GEMV is memory-bound.
 */

#include <ATen/ATen.h>
#include <c10/xpu/XPUStream.h>
#include <sycl/sycl.hpp>
#include <sycl/ext/intel/esimd.hpp>

#include "esimd_kernels/w4a16_gemv.h"
#include "esimd_kernels/fp16_gemv.h"

using fp16 = sycl::half;
using bf16 = sycl::ext::oneapi::bfloat16;

// ROWS config: 4 for GEMV (general), 4 for gate_up_silu
constexpr int ROWS_GEMV = 4;
constexpr int ROWS_GUS  = 4;


/* ─── General GEMV dispatch ─────────────────────────────────────────────────*/
template<typename IT, int GS, int VL>
static void launch_gemv(
    const IT* x, const uint8_t* w, const IT* scales, IT* output,
    int M, int N, int K, sycl::queue& q) {

    int N_groups = (N + ROWS_GEMV - 1) / ROWS_GEMV;
    auto range = sycl::nd_range<3>(
        sycl::range<3>(M, 1, N_groups),
        sycl::range<3>(1, 1, 1));

    q.submit([&](sycl::handler& cgh) {
        cgh.parallel_for(range, [=](sycl::nd_item<3> item) SYCL_ESIMD_KERNEL {
            w4a16_gemv_kernel<IT, GS, VL, ROWS_GEMV>(
                x, w, scales, output, M, N, K, item);
        });
    });
}


/* ─── Gate+Up+SiLU dispatch ─────────────────────────────────────────────────*/
template<typename IT, int GS, int VL>
static void launch_gate_up_silu(
    const IT* x, const uint8_t* w, const IT* scales, IT* output,
    int M, int N, int K, sycl::queue& q) {

    int N_groups = (N + ROWS_GUS - 1) / ROWS_GUS;
    auto range = sycl::nd_range<3>(
        sycl::range<3>(M, 1, N_groups),
        sycl::range<3>(1, 1, 1));

    q.submit([&](sycl::handler& cgh) {
        cgh.parallel_for(range, [=](sycl::nd_item<3> item) SYCL_ESIMD_KERNEL {
            w4a16_gate_up_silu_kernel<IT, GS, VL, ROWS_GUS>(
                x, w, scales, output, M, N, K, item);
        });
    });
}


/* ─── esimd_w4a16_gemv: General W4A16 GEMV ──────────────────────────────────
 *
 * Args:
 *   x:       [M, K]     bf16/fp16  — input activations
 *   weight:  [N, K/2]   uint8      — packed u4 weights (oneDNN layout)
 *   scales:  [N, K/GS]  bf16/fp16  — contiguous per-row (pre-transposed)
 *   output:  [M, N]     bf16/fp16  — pre-allocated output
 *   group_size: 32, 64, or 128
 */
at::Tensor esimd_w4a16_gemv(
    at::Tensor x,
    at::Tensor weight,
    at::Tensor scales,
    at::Tensor output,
    int64_t group_size) {

    TORCH_CHECK(x.dim() == 2, "x must be 2D [M, K]");
    TORCH_CHECK(weight.dim() == 2, "weight must be 2D [N, K/2]");
    TORCH_CHECK(scales.dim() == 2, "scales must be 2D [N, K/GS]");
    TORCH_CHECK(output.dim() == 2, "output must be 2D [M, N]");
    TORCH_CHECK(weight.scalar_type() == at::kByte, "weight must be uint8");

    const int M = x.size(0);
    const int K = x.size(1);
    const int N = weight.size(0);

    TORCH_CHECK(M >= 1 && M <= 8, "M must be 1..8");
    TORCH_CHECK(K % 64 == 0, "K must be multiple of 64");
    TORCH_CHECK(weight.size(1) == K / 2, "weight shape mismatch");
    TORCH_CHECK(group_size == 32 || group_size == 64 || group_size == 128,
                "group_size must be 32, 64, or 128");
    TORCH_CHECK(K % group_size == 0, "K must be divisible by group_size");
    TORCH_CHECK(scales.size(0) == N, "scales row count must match N");
    TORCH_CHECK(scales.size(1) == K / group_size, "scales col count mismatch");
    TORCH_CHECK(output.size(0) == M && output.size(1) == N, "output shape mismatch");
    TORCH_CHECK(scales.scalar_type() == x.scalar_type(),
                "scales dtype must match input dtype");

    sycl::queue& queue = c10::xpu::getCurrentXPUStream(x.device().index()).queue();

    #define LAUNCH_GEMV(IT, gs, vl) \
        launch_gemv<IT, gs, vl>( \
            (const IT*)x.data_ptr(), \
            (const uint8_t*)weight.data_ptr(), \
            (const IT*)scales.data_ptr(), \
            (IT*)output.data_ptr(), \
            M, N, K, queue)

    #define DISPATCH_GEMV_GS(IT, gs) do { \
        if (K >= 4 * gs) { LAUNCH_GEMV(IT, gs, 4 * gs); } \
        else if (K >= 2 * gs) { LAUNCH_GEMV(IT, gs, 2 * gs); } \
        else { LAUNCH_GEMV(IT, gs, gs); } \
    } while(0)

    #define DISPATCH_GEMV_DTYPE(IT) do { \
        switch (group_size) { \
            case 32:  DISPATCH_GEMV_GS(IT, 32);  break; \
            case 64:  DISPATCH_GEMV_GS(IT, 64);  break; \
            case 128: DISPATCH_GEMV_GS(IT, 128); break; \
        } \
    } while(0)

    switch (x.scalar_type()) {
        case at::kHalf:
            DISPATCH_GEMV_DTYPE(fp16);
            break;
        case at::kBFloat16:
            DISPATCH_GEMV_DTYPE(bf16);
            break;
        default:
            TORCH_CHECK(false, "esimd_w4a16_gemv: unsupported dtype (expected fp16 or bf16)");
    }

    #undef DISPATCH_GEMV_DTYPE
    #undef DISPATCH_GEMV_GS
    #undef LAUNCH_GEMV

    return output;
}


/* ─── esimd_w4a16_gate_up_silu: Fused gate+up+SiLU for shared expert ────────
 *
 * Args:
 *   x:       [M, K]       bf16/fp16  — input activations
 *   weight:  [2*N, K/2]   uint8      — packed u4 (first N rows=gate, next N=up)
 *   scales:  [2*N, K/GS]  bf16/fp16  — contiguous per-row
 *   output:  [M, N]       bf16/fp16  — pre-allocated output
 *   N_half:  int          — N (half of weight rows, output dim)
 *   group_size: 32, 64, or 128
 */
at::Tensor esimd_w4a16_gate_up_silu(
    at::Tensor x,
    at::Tensor weight,
    at::Tensor scales,
    at::Tensor output,
    int64_t N_half,
    int64_t group_size) {

    TORCH_CHECK(x.dim() == 2, "x must be 2D [M, K]");
    TORCH_CHECK(weight.dim() == 2, "weight must be 2D [2*N, K/2]");
    TORCH_CHECK(scales.dim() == 2, "scales must be 2D [2*N, K/GS]");
    TORCH_CHECK(output.dim() == 2, "output must be 2D [M, N]");
    TORCH_CHECK(weight.scalar_type() == at::kByte, "weight must be uint8");

    const int M = x.size(0);
    const int K = x.size(1);
    const int N = (int)N_half;

    TORCH_CHECK(M >= 1 && M <= 8, "M must be 1..8");
    TORCH_CHECK(K % 64 == 0, "K must be multiple of 64");
    TORCH_CHECK(weight.size(0) == 2 * N, "weight must have 2*N rows");
    TORCH_CHECK(weight.size(1) == K / 2, "weight shape mismatch");
    TORCH_CHECK(group_size == 32 || group_size == 64 || group_size == 128,
                "group_size must be 32, 64, or 128");
    TORCH_CHECK(K % group_size == 0, "K must be divisible by group_size");
    TORCH_CHECK(scales.size(0) == 2 * N, "scales row count must match 2*N");
    TORCH_CHECK(scales.size(1) == K / group_size, "scales col count mismatch");
    TORCH_CHECK(output.size(0) == M && output.size(1) == N, "output shape mismatch");

    sycl::queue& queue = c10::xpu::getCurrentXPUStream(x.device().index()).queue();

    #define LAUNCH_GUS(IT, gs, vl) \
        launch_gate_up_silu<IT, gs, vl>( \
            (const IT*)x.data_ptr(), \
            (const uint8_t*)weight.data_ptr(), \
            (const IT*)scales.data_ptr(), \
            (IT*)output.data_ptr(), \
            M, N, K, queue)

    #define DISPATCH_GUS_GS(IT, gs) do { \
        if (K >= 4 * gs) { LAUNCH_GUS(IT, gs, 4 * gs); } \
        else if (K >= 2 * gs) { LAUNCH_GUS(IT, gs, 2 * gs); } \
        else { LAUNCH_GUS(IT, gs, gs); } \
    } while(0)

    #define DISPATCH_GUS_DTYPE(IT) do { \
        switch (group_size) { \
            case 32:  DISPATCH_GUS_GS(IT, 32);  break; \
            case 64:  DISPATCH_GUS_GS(IT, 64);  break; \
            case 128: DISPATCH_GUS_GS(IT, 128); break; \
        } \
    } while(0)

    switch (x.scalar_type()) {
        case at::kHalf:
            DISPATCH_GUS_DTYPE(fp16);
            break;
        case at::kBFloat16:
            DISPATCH_GUS_DTYPE(bf16);
            break;
        default:
            TORCH_CHECK(false, "esimd_w4a16_gate_up_silu: unsupported dtype");
    }

    #undef DISPATCH_GUS_DTYPE
    #undef DISPATCH_GUS_GS
    #undef LAUNCH_GUS

    return output;
}


/* ─── FP16/BF16 GEMV dispatch ──────────────────────────────────────────────
 *
 * For unquantized linear layers (lm_head, MoE gate).
 * y[M, N] = weight[N, K] @ x[M, K]^T
 *
 * K-split with SLM reduction, GROUP_SIZE=4 threads per output row.
 */
constexpr int FP16_GEMV_GROUP_SIZE = 4;
constexpr int FP16_GEMV_SIMD_W = 128;

template<typename DT>
static void launch_fp16_gemv(
    const DT* x, const DT* weight, DT* output,
    int M, int N, int K, sycl::queue& q) {

    auto range = sycl::nd_range<2>(
        sycl::range<2>(N, FP16_GEMV_GROUP_SIZE),
        sycl::range<2>(1, FP16_GEMV_GROUP_SIZE));

    q.submit([&](sycl::handler& cgh) {
        cgh.parallel_for(range, [=](sycl::nd_item<2> item) SYCL_ESIMD_KERNEL {
            fp16_gemv_kernel<DT, FP16_GEMV_SIMD_W, FP16_GEMV_GROUP_SIZE>(
                x, weight, output, M, N, K, item);
        });
    });
}


at::Tensor esimd_fp16_gemv(
    at::Tensor x,
    at::Tensor weight,
    at::Tensor output) {

    TORCH_CHECK(x.dim() == 2, "x must be 2D [M, K]");
    TORCH_CHECK(weight.dim() == 2, "weight must be 2D [N, K]");
    TORCH_CHECK(output.dim() == 2, "output must be 2D [M, N]");

    const int M = x.size(0);
    const int K = x.size(1);
    const int N = weight.size(0);

    TORCH_CHECK(M >= 1 && M <= 8, "M must be 1..8");
    TORCH_CHECK(weight.size(1) == K, "weight K dim must match input K");
    TORCH_CHECK(K % (FP16_GEMV_GROUP_SIZE * FP16_GEMV_SIMD_W) == 0,
                "K must be divisible by GROUP_SIZE * SIMD_W (512)");
    TORCH_CHECK(output.size(0) == M && output.size(1) == N, "output shape mismatch");
    TORCH_CHECK(weight.scalar_type() == x.scalar_type(),
                "weight dtype must match input dtype");

    sycl::queue& queue = c10::xpu::getCurrentXPUStream(x.device().index()).queue();

    switch (x.scalar_type()) {
        case at::kHalf:
            launch_fp16_gemv<fp16>(
                (const fp16*)x.data_ptr(), (const fp16*)weight.data_ptr(),
                (fp16*)output.data_ptr(), M, N, K, queue);
            break;
        case at::kBFloat16:
            launch_fp16_gemv<bf16>(
                (const bf16*)x.data_ptr(), (const bf16*)weight.data_ptr(),
                (bf16*)output.data_ptr(), M, N, K, queue);
            break;
        default:
            TORCH_CHECK(false, "esimd_fp16_gemv: unsupported dtype (expected fp16 or bf16)");
    }

    return output;
}
