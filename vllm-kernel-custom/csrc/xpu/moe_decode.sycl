/* MoE decode fused ESIMD kernels — SYCL dispatch (optimized v3)
 * Pipeline: fused up_gate_silu → down → gather
 * Supports: bf16/fp16 IO, GPTQ INT4 symmetric, variable group_size (32/64/128)
 *
 * v3: dequant_dot fusion + ROWS batching.
 *   - dequant_dot: fused dequant + dot product without full VL weight vector
 *   - ROWS batching: UP=4, DN=8 rows per thread, sharing input load
 * Reduces thread count and L2 input traffic.
 */

#include <ATen/ATen.h>
#include <c10/xpu/XPUStream.h>
#include <sycl/sycl.hpp>
#include <sycl/ext/intel/esimd.hpp>

#include "esimd_kernels/moe_decode.h"

using fp16 = sycl::half;
using bf16 = sycl::ext::oneapi::bfloat16;

constexpr int ROWS_UP = 4;
constexpr int ROWS_DN = 8;


/* ─── Up+Gate+SiLU dispatch ─────────────────────────────────────────────────*/
template<typename IT, int GS, int VL>
static void launch_up_gate_silu(
    const IT* x, const uint8_t* w13, const IT* w13_scales,
    const int* topk_ids, IT* intermediates,
    int M, int N, int K, int topk, int num_experts,
    sycl::queue& q) {

    int N_groups = (N + ROWS_UP - 1) / ROWS_UP;
    auto range = sycl::nd_range<3>(
        sycl::range<3>(M, topk, N_groups),
        sycl::range<3>(1, 1, 1));

    q.submit([&](sycl::handler& cgh) {
        cgh.parallel_for(range, [=](sycl::nd_item<3> item) SYCL_ESIMD_KERNEL {
            moe_up_gate_silu_rows<IT, GS, VL, ROWS_UP>(
                x, w13, w13_scales, topk_ids, intermediates,
                M, N, K, topk, num_experts, item);
        });
    });
}


/* ─── Down projection dispatch ──────────────────────────────────────────────*/
template<typename IT, int GS, int VL_D>
static void launch_down(
    const IT* intermediates, const uint8_t* w2, const IT* w2_scales,
    const int* topk_ids, IT* down_out,
    int M, int N, int K, int topk, int num_experts,
    sycl::queue& q) {

    int K_groups = (K + ROWS_DN - 1) / ROWS_DN;
    auto range = sycl::nd_range<3>(
        sycl::range<3>(M, topk, K_groups),
        sycl::range<3>(1, 1, 1));

    q.submit([&](sycl::handler& cgh) {
        cgh.parallel_for(range, [=](sycl::nd_item<3> item) SYCL_ESIMD_KERNEL {
            moe_down_rows<IT, GS, VL_D, ROWS_DN>(
                intermediates, w2, w2_scales, topk_ids, down_out,
                M, N, K, topk, num_experts, item);
        });
    });
}


/* ─── Gather (weighted reduce) dispatch ─────────────────────────────────────*/
template<typename IT>
static void launch_gather(
    const IT* down_out, const float* topk_weights, IT* output,
    int M, int K, int topk,
    sycl::queue& q) {

    auto range = sycl::nd_range<2>(
        sycl::range<2>(M, K),
        sycl::range<2>(1, 1));

    q.submit([&](sycl::handler& cgh) {
        cgh.parallel_for(range, [=](sycl::nd_item<2> item) SYCL_ESIMD_KERNEL {
            moe_gather_kernel<IT>(
                down_out, topk_weights, output,
                M, K, topk, item);
        });
    });
}


/* ─── Fused MoE decode: up_gate_silu + down + gather ────────────────────────*/
at::Tensor esimd_moe_decode(
    at::Tensor x,
    at::Tensor w13_qweight,
    at::Tensor w13_scales,
    at::Tensor w2_qweight,
    at::Tensor w2_scales,
    at::Tensor topk_weights,
    at::Tensor topk_ids,
    at::Tensor output,
    int64_t group_size) {

    TORCH_CHECK(x.dim() == 2, "x must be 2D [M, K]");
    TORCH_CHECK(w13_qweight.dim() == 3, "w13_qweight must be 3D [E, 2*N, K/2]");
    TORCH_CHECK(w2_qweight.dim() == 3, "w2_qweight must be 3D [E, K, N/2]");
    TORCH_CHECK(topk_ids.scalar_type() == at::kInt, "topk_ids must be int32");
    TORCH_CHECK(topk_weights.scalar_type() == at::kFloat, "topk_weights must be float32");
    TORCH_CHECK(w13_qweight.scalar_type() == at::kByte, "w13_qweight must be uint8");
    TORCH_CHECK(w2_qweight.scalar_type() == at::kByte, "w2_qweight must be uint8");

    const int M = x.size(0);
    const int K = x.size(1);
    const int num_experts = w13_qweight.size(0);
    const int N = w13_qweight.size(1) / 2;
    const int topk = topk_ids.size(1);

    TORCH_CHECK(M >= 1 && M <= 8, "M must be 1..8 for decode");
    TORCH_CHECK(K % 64 == 0, "K must be multiple of 64");
    TORCH_CHECK(N % 64 == 0, "N must be multiple of 64");
    TORCH_CHECK(group_size == 32 || group_size == 64 || group_size == 128,
                "group_size must be 32, 64, or 128");
    TORCH_CHECK(K % group_size == 0, "K must be divisible by group_size");
    TORCH_CHECK(N % group_size == 0, "N must be divisible by group_size");

    TORCH_CHECK(w13_qweight.size(2) == K / 2);
    TORCH_CHECK(w13_scales.size(0) == num_experts);
    TORCH_CHECK(w13_scales.size(1) == 2 * N);
    TORCH_CHECK(w13_scales.size(2) == K / group_size);
    TORCH_CHECK(w2_qweight.size(0) == num_experts);
    TORCH_CHECK(w2_qweight.size(1) == K);
    TORCH_CHECK(w2_qweight.size(2) == N / 2);
    TORCH_CHECK(w2_scales.size(0) == num_experts);
    TORCH_CHECK(w2_scales.size(1) == K);
    TORCH_CHECK(w2_scales.size(2) == N / group_size);
    TORCH_CHECK(output.size(0) == M && output.size(1) == K);
    TORCH_CHECK(topk_ids.size(0) == M);
    TORCH_CHECK(topk_weights.size(0) == M && topk_weights.size(1) == topk);

    sycl::queue& queue = c10::xpu::getCurrentXPUStream(x.device().index()).queue();

    auto intermediates = at::empty({M * topk, N},
        at::TensorOptions().device(x.device()).dtype(x.scalar_type()));
    auto down_out = at::empty({M * topk, K},
        at::TensorOptions().device(x.device()).dtype(x.scalar_type()));

    #define LAUNCH_UP(IT, gs, vl) \
        launch_up_gate_silu<IT, gs, vl>( \
            (const IT*)x.data_ptr(), \
            (const uint8_t*)w13_qweight.data_ptr(), \
            (const IT*)w13_scales.data_ptr(), \
            topk_ids.data_ptr<int>(), \
            (IT*)intermediates.data_ptr(), \
            M, N, K, topk, num_experts, queue)

    #define LAUNCH_DN(IT, gs, vl) \
        launch_down<IT, gs, vl>( \
            (const IT*)intermediates.data_ptr(), \
            (const uint8_t*)w2_qweight.data_ptr(), \
            (const IT*)w2_scales.data_ptr(), \
            topk_ids.data_ptr<int>(), \
            (IT*)down_out.data_ptr(), \
            M, N, K, topk, num_experts, queue)

    #define DISPATCH_GS(IT, gs) do { \
        if (K >= 4 * gs) { LAUNCH_UP(IT, gs, 4 * gs); } \
        else if (K >= 2 * gs) { LAUNCH_UP(IT, gs, 2 * gs); } \
        else { LAUNCH_UP(IT, gs, gs); } \
        if (N >= 4 * gs) { LAUNCH_DN(IT, gs, 4 * gs); } \
        else if (N >= 2 * gs) { LAUNCH_DN(IT, gs, 2 * gs); } \
        else { LAUNCH_DN(IT, gs, gs); } \
        launch_gather<IT>( \
            (const IT*)down_out.data_ptr(), \
            topk_weights.data_ptr<float>(), \
            (IT*)output.data_ptr(), \
            M, K, topk, queue); \
    } while(0)

    #define DISPATCH_DTYPE(IT) do { \
        switch (group_size) { \
            case 32:  DISPATCH_GS(IT, 32);  break; \
            case 64:  DISPATCH_GS(IT, 64);  break; \
            case 128: DISPATCH_GS(IT, 128); break; \
        } \
    } while(0)

    switch (x.scalar_type()) {
        case at::kHalf:
            DISPATCH_DTYPE(fp16);
            break;
        case at::kBFloat16:
            DISPATCH_DTYPE(bf16);
            break;
        default:
            TORCH_CHECK(false, "esimd_moe_decode: unsupported dtype (expected fp16 or bf16)");
    }

    #undef DISPATCH_DTYPE
    #undef DISPATCH_GS

    return output;
}
